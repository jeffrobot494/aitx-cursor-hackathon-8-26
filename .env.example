# Copy to .env and fill in. .env is gitignored; this file is not.
#
# IMPORTANT: leave a value EMPTY rather than writing a placeholder. lib/env.js
# skips empty values, so an empty key correctly falls back to offline mode.
# A placeholder like "your-key-here" is a non-empty string, so hasKey() returns
# true and every call fails with a 401 instead of degrading gracefully.

# --- keys ------------------------------------------------------------------

# Write path. Without this, /api/tick and /api/propagate can only replay a
# warmed cache/ entry, and error if there isn't one.
XAI_API_KEY=

# Read path retrieval. xAI exposes no embeddings endpoint, so vectors come from
# here. Without it, lib/embed.js falls back to a hashed bag-of-words stub that
# is NOT semantic — see CLAUDE.md section 8.
#
# Changing this changes vector dimensions (stub 256 -> OpenAI 1536), and
# cosine() returns 0 for mismatched lengths. ALWAYS `npm run seed` after
# adding or removing this key, or every NPC silently knows nothing.
OPENAI_API_KEY=

# Read path, when it is pointed away from xAI. See FAST_PROVIDER below.
OPENROUTER_API_KEY=

# --- hosting ---------------------------------------------------------------

# Where data.json lives. Unset it is the repo root. Point it at a mounted
# volume on a host with an ephemeral filesystem, or the world resets on every
# deploy. `npm start` seeds this location once if it is empty.
# DATA_DIR=/data

# Sent to OpenRouter as HTTP-Referer for traffic attribution. Cosmetic.
# PUBLIC_URL=https://hearsay.up.railway.app

# --- optional overrides ----------------------------------------------------

# PORT=3000

# Which provider serves each path: "xai" (default) or "openrouter".
#
# The read path is the one strangers can hit without limit — every visitor
# message is a call — so it is the one to move to a free model on a public
# deploy. Leave the write path on xAI: Grok 4.6 deciding who learns what IS
# the product, the route is admin-gated, and the six pooled events replay from
# the committed cache/ anyway.
# FAST_PROVIDER=openrouter
# REASON_PROVIDER=xai

# Model ids. Defaults are in lib/grok.js. REASON_MODEL/FAST_MODEL are the
# provider-neutral names; the GROK_* spellings still work and take lower
# precedence. Set FAST_MODEL to the OpenRouter id when FAST_PROVIDER=openrouter
# (OpenRouter ids look like "vendor/model:free").
# REASON_MODEL=grok-4.6
# FAST_MODEL=grok-4.20-0309-non-reasoning

# low | medium | high | xhigh. Drop to "low" for the live ablation that shows
# routing quality collapse without real reasoning.
# REASONING_EFFORT=high

# Retrieval floor. Defaults to 0.30 with OpenAI vectors, 0.15 with the stub.
# MIN_SCORE=0.30

# Set to 1 to replay warmed cache/ entries even when XAI_API_KEY is present.
# The safe way to rehearse the demo without burning tokens or risking wifi.
# USE_CACHE=1
